    "profilo": {"descrizione": "due frasi di presentazione", "tipo": "testo"},
    "esperienze": {"descrizione": "le esperienze di lavoro, con anni e ruolo", "tipo": "elenco"},
    "studi": {"descrizione": "i titoli di studio, con anni", "tipo": "elenco"},
    "lingue": {"descrizione": "le lingue e il livello", "tipo": "elenco"}
  },
