# Immagine della sandbox per il JavaScript (05/10/2026): i test della logica dei giochi delle
# estensioni (calliope/estensioni/scheda.py) girano qui dentro con Node e il suo node:test, un
# container usa-e-getta per ogni esecuzione con le stesse regole di quella di Python
# (calliope/agenti/sandbox.py: niente rete, disco in sola lettura salvo la cartella del lavoro,
# utente non root, tetti a tempo, memoria e processi). Solo Node e la sua libreria: niente npm
# usato, nessun pacchetto. Si costruisce con setup/linux/motore/sandbox.sh costruisci javascript
# (o «calliope motore sandbox costruisci javascript»); il nome è
# calliope-sandbox-node:<prime 12 cifre dello SHA-256 di questo file>.
#
# Il giocatore vero gira nel browser degli schermi (un riquadro isolato): qui si prova solo la
# logica pura del gioco (logica.js), e si controlla la sintassi degli altri script.
FROM node:24.21.0-slim

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
           /usr/local/bin/corepack /opt/yarn* \
    && mkdir -p /lavoro /opt/calliope \
    && node -e "require('node:test'); console.log('node ok', process.version)"

LABEL calliope.sandbox="1"
USER 65534:65534
WORKDIR /lavoro
ENV NODE_OPTIONS="--disallow-code-generation-from-strings" LANG=C.UTF-8
