{
  "nome": "libreria_densita",
  "titolo": "Affonda o galleggia",
  "cosa_fa": {"verbo": "mostra", "oggetto": "la densità di oggetti veri e un quiz sull'acqua"},
  "input": {"type": "object", "properties": {}, "required": []},
  "permessi": {},
  "scheda": {"tipo": "gioco", "file": ["logica.js"], "giocatori": {"min": 1, "max": 1},
             "salva": false, "azioni": [],
             "macchina": {
               "anchio": false,
               "inizio": "esplora",
               "fasi": {
                 "esplora": {"pagina": "scelte", "turni": false, "verso": ["quiz", "fine"],
                             "comandi": {
                               "oggetto": {"forme": ["il {n}", "{n}"],
                                           "n": {"valori": {"sughero": ["sughero"],
                                                            "abete": ["abete", "legno"],
                                                            "ghiaccio": ["ghiaccio"],
                                                            "pvc": ["pvc", "plastica"],
                                                            "alluminio": ["alluminio"],
                                                            "ferro": ["ferro"],
                                                            "rame": ["rame"]}},
                                           "etichetta": "{n}"},
                               "quiz": {"forme": ["fammi il quiz", "passiamo al quiz"],
                                        "etichetta": "Al quiz"}}},
                 "quiz": {"pagina": "scelte", "turni": false, "verso": ["esito", "fine"],
                          "comandi": {
                            "galleggia": {"forme": ["galleggia", "sta a galla"],
                                          "etichetta": "Galleggia"},
                            "affonda": {"forme": ["affonda", "va a fondo"],
                                        "etichetta": "Affonda"},
                            "finito": {"forme": ["ho finito", "smetto qui"],
                                       "etichetta": "Ho finito"}}}
               }
             }},
  "livello": "familiare",
  "limiti": {"tempo_s": 5, "memoria_mb": 128}
}
